cc_library_shared {
    name: "libnicm_shim",
    vendor: true,
    compile_multilib: "64",
    srcs: ["NicmShim.cpp"],
    shared_libs: [
        "libdl",
        "libnicm_internal",
    ],
    init_rc: ["nicmd_mainline.rc"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
