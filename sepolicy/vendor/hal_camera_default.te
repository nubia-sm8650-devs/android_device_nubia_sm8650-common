add_service(hal_camera_default, hal_camera_transfer_service)

allow hal_camera_default mnt_vendor_file:dir search;
allow hal_camera_default vendor_persist_camera_file:dir rw_dir_perms;
allow hal_camera_default vendor_persist_camera_file:file create_file_perms;

allow hal_camera_default input_device:dir r_dir_perms;
allow hal_camera_default input_device:chr_file rw_file_perms;

allow hal_camera_default vendor_sysfs_laser:file rw_file_perms;

binder_call(hal_camera_default, platform_app_all)
