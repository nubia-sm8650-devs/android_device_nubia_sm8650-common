android_app {
    name: "TouchscreenRotation",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    srcs: [
        "src/**/*.java",
    ],

    optimize: {
        enabled: false,
    },
}
