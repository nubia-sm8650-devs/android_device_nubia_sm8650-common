soong_namespace {
    imports: [
        "vendor/nubia/sm8650-common",
    ],
}

install_symlink {
    name: "firmware_wifimac.dat_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/kiwi_v2/wifimac.dat",
    symlink_target: "/mnt/vendor/persist/wifimac.dat",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/kiwi_v2/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "firmware_aw_cali.bin_symlink",
    vendor: true,
    installed_location: "firmware/aw_cali.bin",
    symlink_target: "/mnt/vendor/persist/smartpa_cali_data/aw_cali.bin",
}

install_symlink {
    name: "firmware_qcom_gen70900_sqe.fw_symlink",
    vendor: true,
    installed_location: "firmware/qcom/gen70900_sqe.fw",
    symlink_target: "/vendor/firmware/gen70900_sqe.fw",
}

install_symlink {
    name: "firmware_qcom_gen70900_zap.mbn_symlink",
    vendor: true,
    installed_location: "firmware/qcom/gen70900_zap.mbn",
    symlink_target: "/vendor/firmware/gen70900_zap.mbn",
}

install_symlink {
    name: "firmware_qcom_gmu_gen70900.bin_symlink",
    vendor: true,
    installed_location: "firmware/qcom/gmu_gen70900.bin",
    symlink_target: "/vendor/firmware/gmu_gen70900.bin",
}

install_symlink {
    name: "firmware_qca_symlink",
    vendor: true,
    installed_location: "firmware/qca",
    symlink_target: "/vendor/bt_firmware/image",
}

install_symlink {
    name: "firmware_ath12k_WCN7850_hw2.0_amss.bin_symlink",
    vendor: true,
    installed_location: "firmware/ath12k/WCN7850/hw2.0/amss.bin",
    symlink_target: "/vendor/firmware_mnt/image/kiwi/amss20.bin",
}

install_symlink {
    name: "firmware_ath12k_WCN7850_hw2.0_board.bin_symlink",
    vendor: true,
    installed_location: "firmware/ath12k/WCN7850/hw2.0/board.bin",
    symlink_target: "/vendor/firmware_mnt/image/kiwi/bdwlan.elf",
}

install_symlink {
    name: "firmware_ath12k_WCN7850_hw2.0_m3.bin_symlink",
    vendor: true,
    installed_location: "firmware/ath12k/WCN7850/hw2.0/m3.bin",
    symlink_target: "/vendor/firmware_mnt/image/kiwi/phy_ucode20.elf",
}

install_symlink {
    name: "firmware_ath12k_WCN7850_hw2.0_regdb.bin_symlink",
    vendor: true,
    installed_location: "firmware/ath12k/WCN7850/hw2.0/regdb.bin",
    symlink_target: "/vendor/firmware_mnt/image/kiwi/regdb.bin",
}

cc_library_shared {
    name: "libqti_c2_store_abi_check",
    vendor: true,
    defaults: ["libcodec2-hidl-defaults@1.0"],
    shared_libs: ["libcodec2_hidl@1.2"],
    srcs: [
        "c2_store_abi_check/abi_check_1_0.cpp",
        "c2_store_abi_check/abi_check_1_2.cpp",
    ],
}

cc_library_shared {
    name: "libgui_surface_abi_check",
    system_ext_specific: true,
    shared_libs: [
        "libbinder",
        "libgui",
        "libnativewindow",
        "libui",
        "libutils",
    ],
    srcs: ["surface_abi_check/abi_check.cpp"],
}

filegroup {
    name: "sm8650-common-resource-manager",
    srcs: ["audio/resourcemanager_pineapple_mtp.xml"],
}

filegroup {
    name: "sm8650-common-usecase-kv",
    srcs: ["audio/usecaseKvManager.xml"],
}
