soong_namespace {
}

install_symlink {
    name: "firmware_wifimac.dat_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/kiwi_v2/wifimac.dat",
    symlink_target: "/mnt/vendor/persist/wifimac.dat",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/kiwi_v2/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "firmware_aw_cali.bin_symlink",
    vendor: true,
    installed_location: "firmware/aw_cali.bin",
    symlink_target: "/mnt/vendor/persist/smartpa_cali_data/aw_cali.bin",
}

cc_library_shared {
    name: "libqti_c2_store_abi_check",
    vendor: true,
    defaults: ["libcodec2-hidl-defaults@1.0"],
    shared_libs: ["libcodec2_hidl@1.2"],
    srcs: [
        "c2_store_abi_check/abi_check_1_0.cpp",
        "c2_store_abi_check/abi_check_1_2.cpp",
    ],
}

cc_library_shared {
    name: "libgui_surface_abi_check",
    system_ext_specific: true,
    shared_libs: [
        "libbinder",
        "libgui",
        "libnativewindow",
        "libui",
        "libutils",
    ],
    srcs: ["surface_abi_check/abi_check.cpp"],
}
