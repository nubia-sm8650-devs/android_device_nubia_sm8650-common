<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="fan_enable"
        android:title="@string/fan_enable_title"
        android:summary="@string/fan_enable_summary"
        android:defaultValue="false" />

    <androidx.preference.SwitchPreferenceCompat
        android:key="fan_enable_while_charging"
        android:title="@string/fan_enable_while_charging_title"
        android:summary="@string/fan_enable_while_charging_summary"
        android:defaultValue="false" />

    <com.android.settingslib.widget.SliderPreference
        android:key="fan_speed_level"
        android:title="@string/fan_speed_title"
        android:summary="@string/fan_speed_summary"
        android:defaultValue="3" />
</PreferenceScreen>
